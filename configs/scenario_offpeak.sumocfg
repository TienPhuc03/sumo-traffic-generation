<?xml version="1.0" encoding="UTF-8"?>
<!-- Kịch bản 2: Giờ thấp điểm / Off-peak (Lưu lượng thưa ~1.200 xe/h) -->
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="../networks/hangxanh.net.xml"/>
        <route-files value="../routes/routes_offpeak.rou.xml"/>
        <additional-files value="../routes/vtypes.add.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="1.0"/>
    </time>

    <output>
        <summary-output value="../data/summary_offpeak.xml"/>
        <tripinfo-output value="../data/tripinfo_offpeak.xml"/>
        <queue-output value="../data/queue_offpeak.xml"/>
    </output>

    <gui_only>
        <gui-settings-file value="view.xml"/>
        <start value="true"/>
    </gui_only>

    <processing>
        <ignore-route-errors value="true"/>
        <time-to-teleport value="300"/>
    </processing>
</configuration>
