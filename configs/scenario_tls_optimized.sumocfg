<?xml version="1.0" encoding="UTF-8"?>
<!-- Kịch bản 5: Tối ưu hóa chu kỳ đèn tín hiệu (Tăng pha xanh trục Điện Biên Phủ) -->
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="../networks/hangxanh.net.xml"/>
        <route-files value="../routes/routes_peak.rou.xml"/>
        <additional-files value="../routes/vtypes.add.xml,../routes/detectors.add.xml,../networks/tls_optimized.add.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="1.0"/>
    </time>

    <!-- Task 5.3: Cấu hình đầy đủ 5 file đầu ra XML và chu kỳ lấy mẫu (60s) -->
    <output>
        <tripinfo-output value="../data/tripinfo_tls_optimized.xml"/>
        <tripinfo-output.write-unfinished value="true"/>
        <summary-output value="../data/summary_tls_optimized.xml"/>
        <summary-output.period value="60"/>
        <queue-output value="../data/queue_tls_optimized.xml"/>
        <queue-output.period value="60"/>
        <edgedata-output value="../data/edgedata_tls_optimized.xml"/>
        <emission-output value="../data/emission_tls_optimized.xml"/>
    </output>

    <emissions>
        <device.emissions.probability value="1.0"/>
        <device.emissions.period value="60"/>
    </emissions>

    <gui_only>
        <gui-settings-file value="view.xml"/>
        <start value="true"/>
    </gui_only>

    <processing>
        <ignore-route-errors value="true"/>
        <time-to-teleport value="300"/>
    </processing>
</configuration>
